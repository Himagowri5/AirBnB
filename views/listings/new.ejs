<% layout("layouts/boilerplate")%>
<div class="row mt-3">
    <div class="col-8 offset-2">
    <h3>Create a new Listing</h3>
    <br>
    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
         <label for ="title" class ="form-label">Enter Title</label>
        <input name="listing[title]" placeholder="enter title" type="text" class="form-control" required>
        <div class="valid-feedback">Title looks good!</div>   
        </div>

        <div class="mb-3">
            <label for ="description" class ="form-label">Description</label>
            <textarea name="listing[description]" type="text" class="form-control" required></textarea>
            <div class="invalid-feedback">Enter short descrption</div>
        </div>
        
        <div class="mb-3">
            <label for ="image" class ="form-label">Image</label>
            <input name="listing[image]"  type="file" class="form-control" required>
        </div>
        <div class="row">
            <div class="mb-3 col-4">
                <label for ="price" class ="form-label">Price</label>
                <input name="listing[price]" placeholder="enter price" type ="number" class="form-control" required>
                <div class="invalid-feedback">price should be valid</div>
            </div>

            <div class="mb-3 col-md-8">
                <label for ="country" class ="form-label">Country</label>
                <input name="listing[country]" placeholder="enter country" type ="text" class="form-control" required>
                <div class="invalid-feedback">enter the valid country name</div>
            </div>
        </div>
        

        <div class="mb-3">
            <label for ="location" class ="form-label">Location</label>
            <input name="listing[location]" placeholder="enter location" type ="text" class="form-control" required>
            <div class="invalid-feedback">location should be valid</div>
        </div>
        <div  id="categories-container">
            <label>Categories</label>

            <select name="listing[categories][]" class="form-select">
                <option>Mountain</option>
                <option>Beach</option>
                <option>Snow</option>
                <option>Desert</option>
                <option>Rooms</option>
                <option>Tents</option>
                <option>Pool</option>
                <option>Spa</option>
                <option>River</option>
                <option>Adventure</option>
            </select>

            <button type="button" id="addCategory">+</button>
        </div>
        <br>
        
        <button class="btn btn-dark add-btn">Add</button>
        <br><br>
    </form>
    </div>
</div>

<script>
document.getElementById("addCategory").addEventListener("click", () => {
    let container = document.getElementById("categories-container");

    let select = document.createElement("select");
    select.name = "listing[categories][]";
    select.className = "form-select mt-2";

    select.innerHTML = `
        <option>Mountain</option>
        <option>Beach</option>
        <option>Snow</option>
        <option>Desert</option>
        <option>Rooms</option>
        <option>Tents</option>
        <option>Pool</option>
        <option>Spa</option>
        <option>River</option>
        <option>Adventure</option>
    `;

    container.appendChild(select);
});
</script>